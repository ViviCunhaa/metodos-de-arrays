//21. Organizando uma lista 🐠

let nomes = ["Carlos", "Ana", "Pedro", "Mariana", "João", "Beatriz", "Lucas", "Fernanda"];

console.log("Lista original:");
console.log(nomes);

nomes.sort();

console.log("Lista ordenada:");
console.log(nomes);

nomes.reverse();

console.log("Lista invertida:");
console.log(nomes);

let resultado = nomes.join(", ");

console.log("Resultado em string:");
console.log(resultado);